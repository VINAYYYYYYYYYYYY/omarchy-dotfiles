#!/usr/bin/env bash
set -euo pipefail

direction=${1:-}
case "$direction" in
  l|r|u|d) ;;
  *) exit 2 ;;
esac

active=$(hyprctl activewindow -j)
workspace=$(hyprctl activeworkspace -j)
if [[ $(jq -r '.tiledLayout // ""' <<< "$workspace") == scrolling &&
      $(jq -r '.floating // false' <<< "$active") == false ]]; then
  # Scrolling's native fullscreen handler allows leaving full-width windows
  # expanded. Clearing fullscreen first makes the whole strip resize and jump.
  if [[ $direction == l || $direction == r ]]; then
    exec hyprctl dispatch "hl.dsp.layout(\"focus $direction\")"
  fi
  exec hyprctl dispatch "hl.dsp.focus({ direction = \"$direction\" })"
fi

# On other layouts, restore before directional focus as before.
if [[ $(jq -r '.fullscreen // 0' <<< "$active") != 0 ]]; then
  hyprctl dispatch 'hl.dsp.window.fullscreen_state({ internal = 0, client = 0 })' >/dev/null 2>&1 ||
    hyprctl dispatch fullscreenstate 0 0 >/dev/null
fi

hyprctl dispatch "hl.dsp.focus({ direction = \"$direction\" })" >/dev/null 2>&1 ||
  hyprctl dispatch movefocus "$direction" >/dev/null
