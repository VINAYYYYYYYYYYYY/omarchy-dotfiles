#!/usr/bin/env python3
"""Toggle current-workspace tiled windows wide, retaining their prior states."""
import fcntl
import hashlib
import json
import os
from pathlib import Path
import re
import subprocess
import sys


def query(command):
    result = subprocess.run(["hyprctl", "-j", command], check=True, text=True,
                            capture_output=True)
    return json.loads(result.stdout)


def identity(window):
    # Do not restore a new window which happens to reuse a closed one's address.
    return [window.get("stableId"), window.get("pid")]


def state_command(window, internal, client, layout_aware=True):
    address = window["address"]
    if not re.fullmatch(r"0x[0-9a-fA-F]+", address):
        raise ValueError("Invalid window address")
    if internal not in (0, 1, 2, 3) or client not in (0, 1, 2, 3):
        raise ValueError("Invalid fullscreen state")
    aware = "true" if layout_aware else "false"
    return ('dispatch hl.dsp.window.fullscreen_state({ '
            f'internal = {internal}, client = {client}, action = "set", '
            f'layout_aware = {aware}, window = "address:{address}"' + ' })')


def apply(commands):
    if not commands:
        return
    result = subprocess.run(["hyprctl", "--batch", "; ".join(commands)],
                            check=True, text=True, capture_output=True)
    errors = [line for line in result.stdout.splitlines()
              if line.strip() and line.strip().lower() != "ok"]
    if errors:
        raise RuntimeError("; ".join(errors))


def main():
    workspace = query("activeworkspace")
    if workspace.get("tiledLayout") != "scrolling":
        raise RuntimeError("Use this shortcut on a scrolling workspace.")
    workspace_id = workspace["id"]
    session = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE", "default")
    directory = Path.home() / ".local/state/hypr-full-width" / hashlib.sha256(session.encode()).hexdigest()[:16]
    directory.mkdir(parents=True, exist_ok=True)
    state_path = directory / f"workspace-{int(workspace_id)}.json"
    with (directory / "toggle.lock").open("w") as lock:
        # Ignore overlapping keypresses rather than racing save and restore.
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return
        windows = query("clients")
        current = {w["address"]: w for w in windows if w.get("mapped")}
        active = query("activewindow")
        commands = []
        restoring = state_path.exists()
        if restoring:
            saved = json.loads(state_path.read_text())
            for old in saved:
                w = current.get(old["address"])
                if (w is None or identity(w) != old["identity"] or w.get("floating")
                        or w.get("workspace", {}).get("id") != workspace_id):
                    continue
                commands.append(state_command(w, old["internal"], old["client"], old["layout_aware"]))
        else:
            saved = []
            seen_groups = set()
            for w in windows:
                if (not w.get("mapped") or w.get("hidden") or w.get("floating")
                        or w.get("workspace", {}).get("id") != workspace_id):
                    continue
                group = tuple(sorted(w.get("grouped") or [w["address"]]))
                if group in seen_groups:
                    continue
                seen_groups.add(group)
                internal, client = w.get("fullscreen", 0), w.get("fullscreenClient", 0)
                saved.append({"address": w["address"], "identity": identity(w),
                              "internal": internal, "client": client,
                              "layout_aware": w.get("fullscreenHandler", "").lower() != "default"})
                # Hyprland remembers each column's original width until restored.
                if internal != 1 or client != 1:
                    commands.append(state_command(w, 1, 1))
            if not saved:
                return
            temporary = state_path.with_suffix(".tmp")
            temporary.write_text(json.dumps(saved))
            temporary.replace(state_path)
        # Addressed operations can shift the viewport. End on the current window.
        address = active.get("address", "")
        if address in current and re.fullmatch(r"0x[0-9a-fA-F]+", address):
            commands.append(f'dispatch hl.dsp.focus({{ window = "address:{address}" }})')
        apply(commands)
        if restoring:
            state_path.unlink()


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError, RuntimeError, subprocess.CalledProcessError) as error:
        print(f"Full-width toggle: {error}", file=sys.stderr)
        subprocess.run(["notify-send", "Full-width toggle", str(error)], check=False)
        sys.exit(1)
