#!/bin/bash
# Join a Wi-Fi network by name (including hidden networks). Opened from the
# "Other network…" row in the bar's Wi-Fi panel. nmcli asks for the password
# itself (--ask), so it never appears on a command line.
ssid=$(gum input --placeholder "Network name (SSID)" --prompt "Network  ") || exit 130
[[ -z $ssid ]] && exit 130
if nmcli --ask device wifi connect "$ssid" hidden yes; then
  notify-send -a "Wi-Fi" "Connected" "$ssid"
else
  gum style --foreground 1 "Could not connect to $ssid."
  read -rsn1 -p "Press any key to close"
fi
